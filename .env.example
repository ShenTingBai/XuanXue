# SQLite 数据库文件路径
# 默认是新库 xuanxue-r2.db。旧 xuanxue.db 仅作离线只读备份：
# 不得读取、打开、迁移或修改，否则会把 R2/R4 新表建进含历史 PII 的旧库。
DB_PATH=./xuanxue-r2.db

# 反向代理信任的 IP 列表。
# 必须列出**全部**代理跳（含 CDN 回源 IP）；未列出的跳会被当成客户端地址。
# 漏配只会退化为按代理 IP 限流，不会放宽安全性。
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# Nitro 部署 preset（默认：node-server）
NITRO_PRESET=node-server

# SESSION_SECRET — 用于签名会话令牌的密钥，必须设置为强随机值
SESSION_SECRET=<generate-a-strong-random-key>
