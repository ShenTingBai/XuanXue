#!/bin/bash
# 禁止在 main 分支直接提交
BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ]; then
  echo ""
  echo "❌ 禁止在 main 分支直接提交。"
  echo "   请先切功能分支："
  echo "     git checkout -b feat/xxx    (新功能)"
  echo "     git checkout -b fix/xxx     (Bug 修复)"
  echo "     git checkout -b refactor/xxx (重构)"
  echo ""
  exit 1
fi

# 门禁：只检查已暂存文件是否合规，绝不改写工作树。
# 2026-09-13 R4 事故：pre-commit 里的 prettier --write 在门禁验证之后改写了源码，
# 把多语句内联处理器改成 Vue 无法编译的形式，提交树上的 typecheck/build 随即失效。
# 因此这里只保留 check（失败则拒绝提交），格式化由作者显式执行 npm run format。
npx lint-staged
